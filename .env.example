# ==============================================================================
# LECASU GridOps - Configuração de Variáveis de Ambiente
# ==============================================================================

# Servidor HTTP
PORT=3000
NODE_ENV=development

# Base de Dados PostgreSQL
# Pode utilizar a string de ligação unificada DATABASE_URL ou as variáveis individuais
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lecasu_gridops
PGHOST=localhost
PGPORT=5432
PGDATABASE=lecasu_gridops
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Autenticação e Segurança (JWT)
JWT_SECRET=super_segredo_jwt_lecasu_gridops_alterar_em_producao_2026
JWT_EXPIRES_IN=24h

