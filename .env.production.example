# ==============================================================================
# LECASU GridOps — Configuração de Ambiente para Produção (.env.production)
# ==============================================================================

# Modo de Execução do Node.js
NODE_ENV=production
PORT=3000

# Base de Dados PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lecasu_gridops
DB_USER=lecasu_user
DB_PASS=GerarSenhaSeguraAleatoriaComMaisDe20Caracteres!

# Parâmetros de Ligação PostgreSQL (Connection Pool)
DB_POOL_MIN=4
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# Autenticação JWT (Token com entropia de 256 bits ou superior)
# Gerar com: openssl rand -base64 48
JWT_SECRET=substituir_por_chave_criptografica_aleatoria_longa_e_secreta_2026
JWT_EXPIRES_IN=8h

# Domínio e URL Base
APP_URL=https://gridops.lecasu.co.mz
CORS_ORIGIN=https://gridops.lecasu.co.mz

# Nível de Registo de Eventos (Logs)
LOG_LEVEL=info
